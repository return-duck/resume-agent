LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
PORT=7001
# 调用大模型超时（毫秒）与重试次数；Premature close 时可加大
OPENAI_TIMEOUT_MS=180000
OPENAI_MAX_RETRIES=3
# 附件正文注入 prompt 的最大字符数
ANALYSE_MAX_FILE_CHARS=28000
# Knowledge 落盘目录（相对 cwd 或绝对路径）
KNOWLEDGE_DIR=./data/knowledge
# resume-server 根地址（解析 filePath=/api/attachments/... 时拉取附件）
RESUME_SERVER_BASE_URL=http://localhost:8080
